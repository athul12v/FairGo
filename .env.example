# ============================================================================
# FAIRGO PLATFORM — ROOT ENVIRONMENT CONFIGURATION
# Copy this file to .env or use the credentials in your local microservices
# ============================================================================

# 1. SUPABASE DATABASE & CREDENTIALS
# Obtain these from: Supabase Dashboard > Project Settings > Database / API
# For Transaction Pooler (recommended for serverless & backend services):
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct Connection (for migrations):
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API (Project Settings > API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. REDIS / CACHE
REDIS_URL=redis://localhost:6379

# 3. JWT & SECURITY
JWT_SECRET=fairgo_dev_super_secret_jwt_key_minimum_64_characters_long_for_security_compliance
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# 4. MICROSERVICE PORTS (DEFAULT LOCAL)
AUTH_SERVICE_PORT=3001
RIDER_SERVICE_PORT=3002
DRIVER_SERVICE_PORT=3003
TRIP_SERVICE_PORT=3004
PRICING_SERVICE_PORT=3005
PAYMENT_SERVICE_PORT=3006
SUPPORT_SERVICE_PORT=3007
GATEWAY_PORT=3000
