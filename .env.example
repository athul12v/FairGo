# ============================================================================
# FAIRGO PLATFORM — ROOT ENVIRONMENT CONFIGURATION
# Copy this file to .env or use the credentials in your local microservices
# ============================================================================


# 2. REDIS / CACHE
REDIS_URL=redis://localhost:6379

# 3. JWT & SECURITY
JWT_SECRET=fairgo_dev_super_secret_jwt_key_minimum_64_characters_long_for_security_compliance
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# 4. MICROSERVICE PORTS (DEFAULT LOCAL)
AUTH_SERVICE_PORT=3001
RIDER_SERVICE_PORT=3002
DRIVER_SERVICE_PORT=3003
TRIP_SERVICE_PORT=3004
PRICING_SERVICE_PORT=3005
PAYMENT_SERVICE_PORT=3006
SUPPORT_SERVICE_PORT=3007
# 5. FIREBASE / FIRESTORE CONFIGURATION
FIREBASE_PROJECT_ID=fairgo-ride
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@fairgo-ride.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
