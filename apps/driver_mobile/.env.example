# ============================================================================
# FAIRGO DRIVER MOBILE — ENVIRONMENT CONFIGURATION
# Loaded dynamically via flutter_dotenv at application startup
# ============================================================================

# Backend API & Realtime Gateway
API_BASE_URL=http://10.0.2.2:3000
WS_URL=ws://10.0.2.2:3007

# Firebase Credentials
FIREBASE_PROJECT_ID=fairgo-app
FIREBASE_API_KEY=AIzaSy...
FIREBASE_APP_ID=1:1234567890:android:...

# Trip Request & Location Parameters
TRIP_REQUEST_EXPIRY_SECONDS=30
RECONNECT_DELAY_SECONDS=3
STATIONARY_INTERVAL_SECONDS=30
SLOW_INTERVAL_SECONDS=10
FAST_INTERVAL_SECONDS=3
SLOW_SPEED_KMH=2.0
FAST_SPEED_KMH=20.0
LOCATION_DISTANCE_FILTER_METERS=5
