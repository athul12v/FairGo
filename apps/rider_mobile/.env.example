# ============================================================================
# FAIRGO RIDER MOBILE — ENVIRONMENT CONFIGURATION
# Loaded dynamically via flutter_dotenv at application startup
# ============================================================================

# Backend API & Realtime Gateway
API_BASE_URL=http://10.0.2.2:3000
WS_URL=ws://10.0.2.2:3007

# Firebase Credentials
FIREBASE_PROJECT_ID=fairgo-app
FIREBASE_API_KEY=AIzaSy...
FIREBASE_APP_ID=1:1234567890:android:...

# Default Map Location (Bengaluru coordinates)
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946
MAP_DEFAULT_ZOOM=15.0
MAP_DRIVER_MARKER_ZOOM=14.5

# Trip & Search Parameters
DRIVER_SEARCH_TIMEOUT_SECONDS=120
OTP_EXPIRY_SECONDS=300
DRIVER_ARRIVAL_WAIT_FREE_SECONDS=180
MAX_WAYPOINTS=3
MAX_SAVED_PLACES=10

# Network Settings
CONNECT_TIMEOUT_SECONDS=10
RECEIVE_TIMEOUT_SECONDS=30
MAX_RETRIES=3
LOCATION_UPDATE_INTERVAL_MS=3000
PAGE_SIZE=20
