{
  "name": "@fairgo/trip-service",
  "version": "0.1.0",
  "description": "FairGo Trip Service — trip lifecycle state machine",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "jest --testPathPattern='src/__tests__/unit' --passWithNoTests",
    "test:integration": "jest --testPathPattern='src/__tests__/integration' --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fairgo/domain-errors": "workspace:*",
    "@fairgo/event-contracts": "workspace:*",
    "@fairgo/logger": "workspace:*",
    "@fairgo/shared-types": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "prom-client": "^15.1.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
