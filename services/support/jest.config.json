{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", {
      "useESM": true,
      "tsconfig": "tsconfig.json"
    }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@fairgo/shared-types$": "<rootDir>/../../packages/shared-types/src/index.ts",
    "^@fairgo/logger$": "<rootDir>/../../packages/logger/src/index.ts",
    "^@fairgo/domain-errors$": "<rootDir>/../../packages/domain-errors/src/index.ts",
    "^@fairgo/event-contracts$": "<rootDir>/../../packages/event-contracts/src/index.ts"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/server.ts"
  ]
}
