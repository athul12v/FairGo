# Support Service — Environment Configuration
# Copy this file to .env and fill in real values

NODE_ENV=development
PORT=3007
SUPPORT_SERVICE_PORT=3007
LOG_LEVEL=debug

# PostgreSQL Database Connection (Supabase Transaction Pooler recommended)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Redis Cache & Presence Queue
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=fairgo_dev_super_secret_jwt_key_minimum_64_characters_long_for_security_compliance

# WebRTC STUN / TURN
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
